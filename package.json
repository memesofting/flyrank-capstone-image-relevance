{
  "name": "flyrank-capstone-image-relevance",
  "version": "1.0.0",
  "description": "AI image understanding and content matching engine",
  "homepage": "https://github.com/memesofting/flyrank-capstone-image-relevance#readme",
  "bugs": {
    "url": "https://github.com/memesofting/flyrank-capstone-image-relevance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memesofting/flyrank-capstone-image-relevance.git"
  },
  "license": "MIT",
  "author": "memesofting",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js up",
    "db:rollback": "node src/db/migrate.js down",
    "db:status": "node src/db/migrate.js status",
    "corpus:fetch": "node scripts/fetch-corpus.js",
    "corpus:verify": "node scripts/verify-corpus.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:all": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
