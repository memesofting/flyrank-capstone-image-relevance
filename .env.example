# ---------------------------------------------------------------------------
# Environment configuration. Copy to `.env` and adjust.
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# === REQUIRED NOW =========================================================
# Application runtime.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by the application.
# Must match the POSTGRES_* values below (host port is the HOST-side port).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/image_matcher

# Log level: debug | info | warn | error
LOG_LEVEL=info

# === REQUIRED NOW (used by docker-compose.yml) =============================
# These values configure the local PostgreSQL container. docker-compose.yml
# reads them from this file with ${VAR:-default} substitution, so the app and
# the database stay in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_matcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# === DEFERRED: PHASE 2 (vision) =============================================
# Not used in Phase 1. Placeholders only — no provider is implemented yet.
# VISION_PROVIDER=gemini            # gemini | ollama
# GEMINI_API_KEY=                   # required when VISION_PROVIDER=gemini
# OLLAMA_BASE_URL=http://localhost:11434

# === DEFERRED: PHASE 2/3 (embeddings) ======================================
# Not used in Phase 1.
# EMBEDDING_PROVIDER=gemini         # gemini | ollama

# === DEFERRED: PHASE 2/4 (cost budget guard) ==============================
# Not used in Phase 1. See docs/AI-PIPELINE.md.
# AI_DAILY_BUDGET_USD=1.00
# AI_MONTHLY_BUDGET_USD=10.00
# MAX_IMAGE_BATCH_SIZE=50
