# ---------------------------------------------------------------------------
# Environment configuration. Copy to `.env` and adjust.
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# === REQUIRED NOW =========================================================
# Application runtime.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by the application.
# Must match the POSTGRES_* values below (host port is the HOST-side port).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/image_matcher

# Log level: debug | info | warn | error
LOG_LEVEL=info

# === REQUIRED NOW (used by docker-compose.yml) =============================
# These values configure the local PostgreSQL container. docker-compose.yml
# reads them from this file with ${VAR:-default} substitution, so the app and
# the database stay in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_matcher
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# === PHASE 2: AI PIPELINE ==================================================
# Vision classification and caption embedding. See docs/AI-PIPELINE.md.

# Which provider backs vision and embeddings: gemini | ollama
VISION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Required when either provider is `gemini`. Never commit this value.
# Get one from https://aistudio.google.com/apikey
#
# Paste it as a bare value. Do NOT append the trailing comment from this file:
# dotenv discards ` # ...`, but a key pasted with one in the middle of the value
# produces an opaque HTTP 401 rather than a local configuration error.
GEMINI_API_KEY=

# Only for the ollama provider. No vision model was installed on the project
# machine (3.8 GB RAM, ~900 MB free), so this path is implemented and unit-tested
# but has not been exercised end to end. See docs/adr/004-vision-model-availability.md.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=moondream
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Model selection.
#
# gemini-2.5-flash — the obvious first choice — is still listed by the API but
# returns HTTP 404 "no longer available to new users". gemini-3.8-flash was
# observed returning 503 "high demand". gemini-3.5-flash was verified working and
# is the fallback, resolved once per run so a run never silently mixes models.
# Override only if you have re-tested availability yourself.
# VISION_MODEL=gemini-3.8-flash
# VISION_MODEL_FALLBACK=gemini-3.5-flash

# text-embedding-004, which Phase 1 named as the reason for vector(768), is
# deprecated and absent from the model list. gemini-embedding-001 returns exactly
# 768 dimensions at outputDimensionality=768, which is what vector(768) needs.
# Its 768-dimension output is NOT pre-normalised, so it is normalised before it
# is persisted. See docs/adr/002-embedding-dimension.md.
# EMBEDDING_MODEL=gemini-embedding-001

# 0 disables Gemini's thinking budget. Classification is not a reasoning task:
# measured, thinking cost 220 output tokens per image for no accuracy gain.
GEMINI_THINKING_BUDGET=0

# === PHASE 2/4: COST BUDGET GUARD ==========================================
# The guard refuses new AI work when tracked spend reaches these ceilings. It
# compares against ai_calls, which includes failed and retried calls.
#
# Worst case for the whole 61-image corpus on gemini-3.5-flash, priced at the
# PAID list rate because free-tier status is not detectable from the API
# response: about $0.32. On the free tier the real charge is $0.
# AI_DAILY_BUDGET_USD=1.00
# AI_MONTHLY_BUDGET_USD=10.00

# Hard ceiling on how many images one batch may enqueue.
# MAX_IMAGE_BATCH_SIZE=50

# Set to `stub` to run the pipeline end to end against deterministic in-memory
# providers: no network calls, no API key, no quota. Used by the test suite and
# for verifying the pipeline shape before spending anything.
# AI_PROVIDER_MODE=stub
